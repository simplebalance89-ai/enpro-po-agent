# Ariba/Coupa PO Automation Agent — Environment Variables
# Copy to .env and fill in values.
# On Azure Container App these are injected via Bicep + Key Vault.

# ── App ──
PORT=8000
ENVIRONMENT=development
DEBUG=false

# ── Security ──
# Set APP_API_KEY to protect mutating routes (approve, reject, edit, submit, crosswalk build, etc.)
# Leave empty in local dev; REQUIRED in production.
APP_API_KEY=

# Set ADMIN_PASSPHRASE to enable admin-only tabs in the review portal UI.
# If empty, admin mode is inaccessible.
ADMIN_PASSPHRASE=

# ── Azure Blob Storage ──
BLOB_ACCOUNT_URL=https://enproaidatav1.blob.core.windows.net
BLOB_CONTAINER=ariba-coupa
BLOB_CONNECTION_STRING=

# ── Azure Document Intelligence (PDF parsing) ──
DOC_INTEL_ENDPOINT=https://enpro-filtration-ai.cognitiveservices.azure.com/
DOC_INTEL_KEY=

# ── Azure OpenAI (optional — AI-assisted field mapping) ──
AZURE_OPENAI_ENDPOINT=https://enpro-filtration-ai.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=gpt-4.1

# ── Microsoft Graph API (email polling — not yet connected) ──
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_MAILBOX=orders@enproinc.com
GRAPH_POLL_INTERVAL=60

# ── Dynamics 365 CRM (quote lookup — not yet connected) ──
DYNAMICS_ORG_URL=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=

# ── P21 SQL (direct ODBC — only from on-prem, not from Azure) ──
P21_SQL_SERVER=
P21_SQL_DATABASE=P21
P21_SQL_UID=
P21_SQL_PWD=

# ── Azure SQL Staging DB (optional) ──
STAGING_SQL_SERVER=
STAGING_SQL_DATABASE=po_staging

# ── P21 Transaction API (direct SO creation via REST) ──
# Requires P21 Middleware (Transaction API v2) installed on the P21 server
P21_BASE_URL=
P21_API_USERNAME=
P21_API_PASSWORD=
P21_VERIFY_SSL=false
P21_DEFAULT_TAKER=POAGENT
P21_DEFAULT_COMPANY_ID=1
P21_DEFAULT_LOCATION_ID=10
# Set to true to auto-submit approved POs to P21 API (skips CISM batch)
P21_AUTO_SUBMIT_ON_APPROVE=false

# ── Persistent Storage Paths ──
# Azure Files mount at /app/data (Container App) or Render disk
CROSSWALK_DIR=/app/data/crosswalks
CISM_OUTPUT_DIR=/app/data/cism_output
CISM_SO_OUTPUT_DIR=/app/data/cism_so_output
